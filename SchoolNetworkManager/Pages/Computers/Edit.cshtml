@page "{id:int}"
@model SchoolNetworkManager.Pages.Computers.EditModel

@{
    ViewData["Title"] = "Επεξεργασία Υπολογιστή";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Επεξεργασία Υπολογιστή</h1>
        <p class="text-muted mb-0">Τροποποίηση στοιχείων καταχώρησης</p>
    </div>

    <a class="btn btn-outline-secondary" asp-page="./Index">
        Πίσω στη λίστα
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Computer.Id" />
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Computer.IpAddress" class="form-label"></label>
                    <input asp-for="Computer.IpAddress" class="form-control" />
                    <span asp-validation-for="Computer.IpAddress" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Computer.MachineType" class="form-label"></label>
                    <select asp-for="Computer.MachineType" class="form-select">
                        @foreach (var type in MachineTypes.All)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Computer.Name" class="form-label"></label>
                    <input asp-for="Computer.Name" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label asp-for="Computer.MacAddress" class="form-label"></label>
                    <input asp-for="Computer.MacAddress" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label asp-for="Computer.Location" class="form-label"></label>
                    <input asp-for="Computer.Location" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label asp-for="Computer.Username" class="form-label"></label>
                    <input asp-for="Computer.Username" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label asp-for="Computer.Password" class="form-label"></label>
                    <input asp-for="Computer.Password" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Computer.Extras" class="form-label"></label>
                    <input asp-for="Computer.Extras" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Computer.Notes" class="form-label"></label>
                    <textarea asp-for="Computer.Notes" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-md-6">
                    <label asp-for="Computer.Comments" class="form-label"></label>
                    <textarea asp-for="Computer.Comments" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-md-12">
                    <div class="form-check form-check-inline">
                        <input asp-for="Computer.HasLanMessenger" class="form-check-input" />
                        <label asp-for="Computer.HasLanMessenger" class="form-check-label"></label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input asp-for="Computer.HasVeyon" class="form-check-input" />
                        <label asp-for="Computer.HasVeyon" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-end gap-2">
                <a class="btn btn-outline-secondary" asp-page="./Index">Ακύρωση</a>
                <button type="submit" class="btn btn-primary">Αποθήκευση αλλαγών</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}