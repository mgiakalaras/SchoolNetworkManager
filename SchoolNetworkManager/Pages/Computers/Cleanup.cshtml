@page
@model SchoolNetworkManager.Pages.Computers.CleanupModel

@{
    ViewData["Title"] = "Ξεσκαρτάρισμα διευθύνσεων";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="mb-1">🧹 Ξεσκαρτάρισμα διευθύνσεων</h1>
        <p class="text-muted mb-0">Ποιες IP έχουν σταθερή συσκευή (📌 Static) και ποιες είναι απλώς διευθύνσεις DHCP (🔄 Dynamic).</p>
    </div>
    <a class="icon-action" asp-page="./Index" data-hint="Πίσω στη λίστα" aria-label="Πίσω στη λίστα">↩️</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info shadow-sm">@Model.StatusMessage</div>
}

<div class="cleanup-stats mb-4">
    <div class="cleanup-stat"><div class="cleanup-count">@Model.Total</div><small>καταχωρημένες διευθύνσεις</small></div>
    <div class="cleanup-stat"><div class="cleanup-count text-primary">@Model.StaticCount</div><small>📌 static (μετρούν ως συσκευές)</small></div>
    <div class="cleanup-stat"><div class="cleanup-count text-muted">@Model.Dynamic.Count</div><small>🔄 dynamic</small></div>
    <div class="cleanup-stat"><div class="cleanup-count text-warning">@(Model.Sure.Count + Model.Maybe.Count)</div><small>προς έλεγχο παρακάτω</small></div>
</div>

<!-- Εύρος DHCP -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h6 mb-2">⚡ Όλο το εύρος DHCP με μία κίνηση</h2>
        <p class="text-muted small mb-3">
            Αν ξέρεις το εύρος που μοιράζει ο router (π.χ. στο Speedport: Home Network → DHCP),
            γράψ' το εδώ. Όσες διευθύνσεις του έχουν χώρο, κωδικούς, σημειώσεις ή χαρακτηριστικά μένουν Static.
        </p>
        <form method="post" asp-page-handler="Range" class="row g-2 align-items-center"
              onsubmit="return confirm('Να γίνουν Dynamic οι διευθύνσεις του εύρους που δεν έχουν στοιχεία συσκευής;');">
            <div class="col-sm-5 col-lg-4">
                <input name="range" class="form-control font-monospace" placeholder="192.168.2.100-200" required />
            </div>
            <div class="col-auto form-check ms-2">
                <input type="checkbox" class="form-check-input" name="clearDetected" value="true" id="clearRange" checked />
                <label class="form-check-label small" for="clearRange">Καθάρισε MAC/κατασκευαστή που βρέθηκαν αυτόματα</label>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">🔄 Κάν' τες Dynamic</button>
            </div>
        </form>
    </div>
</div>

<form method="post" asp-page-handler="Dynamic">
    <!-- Σίγουρα -->
    <div class="card shadow-sm mb-4 cleanup-group">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-semibold">🗑️ Χωρίς κανένα στοιχείο — σχεδόν σίγουρα Dynamic <span class="badge text-bg-secondary">@Model.Sure.Count</span></span>
            @if (Model.Sure.Any())
            {
                <span class="small text-muted">Δεν έχουν όνομα, MAC, χώρο, σημειώσεις ή ιστορικό. Είναι ήδη επιλεγμένες.</span>
            }
        </div>
        <div class="card-body">
            @if (!Model.Sure.Any())
            {
                <div class="text-muted">Τίποτα εδώ. 👍</div>
            }
            else
            {
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-check-group="sure" data-check="true">✓ Όλες</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-check-group="sure" data-check="false">✕ Καμία</button>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var c in Model.Sure)
                    {
                        <label class="address-chip">
                            <input type="checkbox" class="form-check-input m-0" name="ids" value="@c.Id" data-group="sure" checked />
                            <span class="font-monospace">@c.IpAddress</span>
                        </label>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Ίσως -->
    <div class="card shadow-sm mb-4 cleanup-group">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-semibold">🤔 Μόνο αυτόματα στοιχεία — έλεγξε <span class="badge text-bg-warning">@Model.Maybe.Count</span></span>
            <span class="small text-muted">Έχουν MAC ή όνομα από την ανίχνευση, αλλά κανείς δεν έγραψε χώρο ή κάτι άλλο. Τσέκαρε όσες δεν είναι σταθερές συσκευές.</span>
        </div>
        <div class="card-body">
            @if (!Model.Maybe.Any())
            {
                <div class="text-muted">Τίποτα εδώ. 👍</div>
            }
            else
            {
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-check-group="maybe" data-check="true">✓ Όλες</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-check-group="maybe" data-check="false">✕ Καμία</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr><th style="width:2rem"></th><th>IP</th><th>Όνομα</th><th>MAC / κατασκευαστής</th><th>Τελευταία φορά online</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Maybe)
                            {
                                <tr>
                                    <td><input type="checkbox" class="form-check-input" name="ids" value="@c.Id" data-group="maybe" id="m@(c.Id)" /></td>
                                    <td><label for="m@(c.Id)" class="font-monospace fw-semibold">@c.IpAddress</label></td>
                                    <td>@(string.IsNullOrWhiteSpace(c.Name) ? "—" : c.Name)</td>
                                    <td>
                                        <span class="font-monospace">@(c.MacAddress ?? "—")</span>
                                        @if (!string.IsNullOrWhiteSpace(c.Vendor))
                                        {
                                            <div class="small text-muted">@c.Vendor</div>
                                        }
                                    </td>
                                    <td class="small">@(c.LastSeenOnline?.ToString("dd/MM/yyyy HH:mm") ?? "ποτέ")</td>
                                    <td class="text-end"><a class="row-action" asp-page="./Edit" asp-route-id="@c.Id" asp-route-returnUrl="@Url.Page("./Cleanup")" data-hint="Είναι συσκευή: συμπλήρωσε χώρο / όνομα" aria-label="Επεξεργασία">✏️</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (Model.Sure.Any() || Model.Maybe.Any())
    {
        <div class="card shadow-sm mb-4 sticky-bottom cleanup-actions">
            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                <strong><span id="cleanupSelected">0</span> επιλεγμένες</strong>
                <div class="form-check mb-0">
                    <input type="checkbox" class="form-check-input" name="clearDetected" value="true" id="clearSel" checked />
                    <label class="form-check-label small" for="clearSel">Καθάρισε MAC / κατασκευαστή / ports που βρέθηκαν αυτόματα</label>
                </div>
                <button type="submit" class="btn btn-primary ms-auto">🔄 Κάν' τες Dynamic</button>
            </div>
        </div>
    }
</form>

<!-- Ήδη Dynamic -->
<div class="card shadow-sm mb-4 cleanup-group">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="fw-semibold">🔄 Ήδη Dynamic <span class="badge text-bg-secondary">@Model.Dynamic.Count</span></span>
        @if (Model.Dynamic.Any())
        {
            <a class="small" asp-page="./Cleanup" asp-route-ShowDynamic="@(!Model.ShowDynamic)">@(Model.ShowDynamic ? "Απόκρυψη" : "Εμφάνιση")</a>
        }
    </div>
    @if (Model.ShowDynamic && Model.Dynamic.Any())
    {
        <div class="card-body">
            <form method="post" asp-page-handler="Static">
                <p class="small text-muted">Τσέκαρε όσες μπήκαν κατά λάθος και πάτα «Ξανά Static».</p>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var c in Model.Dynamic)
                    {
                        <label class="address-chip">
                            <input type="checkbox" class="form-check-input m-0" name="ids" value="@c.Id" />
                            <span class="font-monospace">@c.IpAddress</span>
                            @if (c.IsOnline == true)
                            {
                                <span class="small text-success" title="Κάποια συσκευή την έχει πάρει τώρα">●</span>
                            }
                        </label>
                    }
                </div>
                <button type="submit" class="btn btn-outline-primary">📌 Ξανά Static</button>
            </form>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const counter = document.getElementById("cleanupSelected");
            function count() {
                if (!counter) return;
                counter.textContent = document.querySelectorAll('form input[name="ids"][data-group]:checked').length;
            }
            document.querySelectorAll("[data-check-group]").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const on = btn.dataset.check === "true";
                    document.querySelectorAll('input[data-group="' + btn.dataset.checkGroup + '"]').forEach(function (cb) { cb.checked = on; });
                    count();
                });
            });
            document.addEventListener("change", function (e) { if (e.target.matches('input[name="ids"]')) count(); });
            count();
        })();
    </script>
}
