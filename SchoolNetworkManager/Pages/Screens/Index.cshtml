@page
@model SchoolNetworkManager.Pages.Screens.IndexModel
@{
    ViewData["Title"] = "Τοίχος οθονών";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h4 mb-0">🖥️ Τοίχος οθονών</h1>
    <div class="d-flex align-items-center gap-2">
        <span id="wallStatus" class="badge bg-success-subtle text-success border border-success-subtle">● ζωντανά</span>
        <form method="get" class="d-flex align-items-center gap-2">
            <select name="Location" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">Όλοι οι χώροι</option>
                @foreach (var loc in Model.Locations)
                {
                    <option value="@loc" selected="@(string.Equals(loc, Model.Location, StringComparison.OrdinalIgnoreCase))">@loc</option>
                }
            </select>
        </form>
    </div>
</div>

@if (Model.Tiles.Count == 0)
{
    <div class="alert alert-info">
        Δεν υπάρχουν υπολογιστές με agent σε αυτόν τον χώρο. Οι μικρογραφίες εμφανίζονται μόνο για υπολογιστές που έχουν τον agent (έκδοση 1.2+).
    </div>
}
else
{
    <div class="alert alert-light border small py-2">
        Οι μικρογραφίες τραβιούνται <strong>μόνο όσο είσαι σε αυτή τη σελίδα</strong> και δεν αποθηκεύονται πουθενά.
    </div>
    <div class="screen-wall">
        @foreach (var t in Model.Tiles)
        {
            <div class="screen-tile" data-id="@t.Id">
                <div class="screen-thumb">
                    <img alt="@t.Name" data-src="?handler=Image&id=@t.Id" />
                    <div class="screen-empty">χωρίς εικόνα</div>
                </div>
                <div class="screen-meta">
                    <a asp-page="/Computers/Details" asp-route-id="@t.Id" class="screen-name text-truncate" title="@t.Name">
                        <span class="dot @(t.Online ? "on" : "off")"></span>@t.Name
                    </a>
                    <span class="screen-actions">
                        @if (Model.RustDeskReady && !string.IsNullOrWhiteSpace(t.RustDeskId))
                        {
                            <a href="rustdesk://@t.RustDeskId" title="Σύνδεση RustDesk">🖥️</a>
                        }
                    </span>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<style>
    .screen-wall { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
    .screen-tile { background: var(--card-bg, #1b1f27); border: 1px solid rgba(255,255,255,.08); border-radius: 12px; overflow: hidden; }
    .screen-thumb { position: relative; aspect-ratio: 16/10; background: #000; display: flex; align-items: center; justify-content: center; }
    .screen-thumb img { width: 100%; height: 100%; object-fit: cover; display: none; }
    .screen-thumb img.live { display: block; }
    .screen-empty { position: absolute; color: #556; font-size: .8rem; }
    .screen-meta { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 6px 10px; }
    .screen-name { text-decoration: none; font-size: .85rem; max-width: 80%; }
    .screen-actions a { text-decoration: none; }
    .screen-meta .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
    .screen-meta .dot.on { background: #35c759; }
    .screen-meta .dot.off { background: #6b7280; }
</style>
<script>
(function () {
    var tiles = Array.from(document.querySelectorAll('.screen-tile'));
    if (!tiles.length) return;

    function refreshTile(tile, ready) {
        var id = parseInt(tile.getAttribute('data-id'), 10);
        var img = tile.querySelector('img');
        if (ready.indexOf(id) === -1) {
            img.classList.remove('live');
            return;
        }
        var url = img.getAttribute('data-src') + '&t=' + Date.now();
        var probe = new Image();
        probe.onload = function () { img.src = url; img.classList.add('live'); };
        probe.src = url;
    }

    async function tick() {
        try {
            var r = await fetch('?handler=Ping', { headers: { 'RequestVerificationToken': '' } });
            var data = await r.json();
            var ready = data.ready || [];
            tiles.forEach(function (t) { refreshTile(t, ready); });
            document.getElementById('wallStatus').className = 'badge bg-success-subtle text-success border border-success-subtle';
        } catch (e) {
            document.getElementById('wallStatus').className = 'badge bg-secondary-subtle text-secondary border';
        }
    }

    tick();
    setInterval(tick, 2500);
})();
</script>
}
