        <input type="search" id="helpSearch" class="form-control form-control-sm" style="width: 220px;" placeholder="🔎 Αναζήτηση στη βοήθεια" />
        <button type="button" class="btn btn-sm btn-outline-primary" onclick="window.print()">🖨 Εκτύπωση / PDF</button>
    </div>
</div>

<div class="d-none d-print-block mb-3">
    <h1>School Network Manager — Οδηγός ομάδας πληροφορικής</h1>
</div>

<div class="row g-4">
    <!-- ====================== Περιεχόμενα ====================== -->
