@page
@model SchoolNetworkManager.Pages.Rules.IndexModel
@using SchoolNetworkManager.Services

@{
    ViewData["Title"] = "Κανονισμοί";
    var doc = Model.Current;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3 d-print-none">
    <div>
        <h1 class="mb-1">📜 Κανονισμοί</h1>
        <p class="text-muted mb-0">Ο κανονισμός των εργαστηρίων και οι κανόνες για τους μαθητές — εδώ τους διορθώνετε, από εδώ τους τυπώνετε.</p>
    </div>
    <div class="page-actions">
        <a class="icon-action @(Model.Edit ? "" : "is-primary")" asp-page="./Index" asp-route-Doc="@doc.Key" data-hint="Προβολή" aria-label="Προβολή">👁️</a>
        <a class="icon-action @(Model.Edit ? "is-primary" : "")" asp-page="./Index" asp-route-Doc="@doc.Key" asp-route-Edit="true" data-hint="Επεξεργασία κειμένου" aria-label="Επεξεργασία">✏️</a>
        <span class="icon-action-sep"></span>
        <a class="icon-action" asp-page="./Index" asp-page-handler="Word" asp-route-Doc="@doc.Key" data-hint="Λήψη ως Word για επεξεργασία" aria-label="Λήψη Word">📝</a>
        <a class="icon-action" asp-page="/Public/Print" asp-route-Doc="@doc.Key" target="_blank" data-hint="Εκτύπωση: επίσημο έγγραφο ή αφίσα" aria-label="Εκτύπωση">🖨️</a>
        @if (Model.PortalEnabled && doc.IsPublic)
        {
            <a class="icon-action" asp-page="/Public/Rules" asp-route-Doc="@doc.Key" target="_blank" data-hint="Όπως το βλέπουν οι μαθητές (δημόσια σελίδα)" aria-label="Δημόσια σελίδα">🌐</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@(Model.StatusKind ?? "info") shadow-sm d-print-none">@Model.StatusMessage</div>
}

<ul class="nav nav-pills doc-tabs mb-3 d-print-none">
    @foreach (var d in Model.Documents)
    {
        <li class="nav-item">
            <a class="nav-link @(d.Key == doc.Key ? "active" : "")" asp-page="./Index" asp-route-Doc="@d.Key" asp-route-Edit="@Model.Edit">
                @d.Icon @SchoolDocuments.ShortName(d.Key)
                @if (!d.IsPublic)
                {
                    <span class="small ms-1" title="Δεν φαίνεται στη δημόσια σελίδα">🔒</span>
                }
            </a>
        </li>
    }
</ul>

<div class="row g-4">
    <div class="col-lg-8">
        @if (Model.Edit)
        {
            <form method="post" asp-page-handler="Save" asp-route-Doc="@doc.Key" class="card shadow-sm">
                <div class="card-body d-grid gap-3">
                    <div>
                        <label class="form-label" for="docTitle">Τίτλος</label>
                        <input id="docTitle" name="title" class="form-control form-control-lg" value="@doc.Title" maxlength="160" />
                    </div>
                    <div>
                        <label class="form-label d-flex justify-content-between" for="docBody">
                            <span>Κείμενο</span>
                            <span class="small text-muted">
                                <code># Ενότητα</code> · <code>## Υποενότητα</code> · <code>- κουκκίδα</code> · <code>1. αρίθμηση</code> · <code>&gt; πλαίσιο</code> · <code>Πεδίο: ____</code> · <code>**έντονα**</code>
                            </span>
                        </label>
                        <textarea id="docBody" name="body" class="form-control doc-editor" rows="24" spellcheck="true">@doc.Body</textarea>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="isPublic" value="true" id="docPublic" checked="@doc.IsPublic" />
                            <label class="form-check-label" for="docPublic">🌐 Φαίνεται στη δημόσια σελίδα (μαθητές, εκπαιδευτικοί)</label>
                        </div>
                        <button type="submit" class="btn btn-primary ms-auto">💾 Αποθήκευση</button>
                    </div>
                </div>
            </form>

            <form method="post" asp-page-handler="Reset" asp-route-Doc="@doc.Key" class="mt-2 text-end"
                  onsubmit="return confirm('Να αντικατασταθεί το κείμενο με το αρχικό πρότυπο; Ό,τι έχετε γράψει θα χαθεί.');">
                <button type="submit" class="btn btn-link btn-sm text-muted">↺ Επαναφορά αρχικού προτύπου</button>
            </form>
        }
        else
        {
            <article class="card shadow-sm doc-view">
                <div class="card-body">
                    <div class="doc-school d-none d-print-block">@Model.SchoolTitle</div>
                    <h1 class="doc-title">@doc.Title</h1>
                    <div class="doc-body">@Html.Raw(DocText.ToHtml(doc.Body))</div>
                    <div class="doc-meta">
                        Τελευταία αλλαγή @doc.UpdatedAt.ToString("dd/MM/yyyy")@(string.IsNullOrWhiteSpace(doc.UpdatedBy) ? "" : " · " + doc.UpdatedBy)
                    </div>
                </div>
            </article>
        }
    </div>

    <div class="col-lg-4 d-print-none">
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">📎 Επίσημο αρχείο</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(doc.FilePath))
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="fs-3">@(doc.FilePath.EndsWith(".pdf") ? "📕" : "📘")</span>
                        <div class="min-w-0">
                            <a class="fw-semibold text-break" asp-page="./Index" asp-page-handler="File" asp-route-Doc="@doc.Key">@doc.FileName</a>
                            <div class="small text-muted">Ανέβηκε @doc.UpdatedAt.ToString("dd/MM/yyyy")</div>
                        </div>
                        <form method="post" asp-page-handler="RemoveFile" asp-route-Doc="@doc.Key" class="ms-auto"
                              onsubmit="return confirm('Αφαίρεση του αρχείου;');">
                            <button type="submit" class="row-action is-danger" data-hint="Αφαίρεση αρχείου" aria-label="Αφαίρεση">🗑️</button>
                        </form>
                    </div>
                }
                else
                {
                    <p class="small text-muted">Δεν έχει ανέβει αρχείο. Η σελίδα δείχνει το κείμενο αριστερά.</p>
                }

                <form method="post" asp-page-handler="Upload" asp-route-Doc="@doc.Key" enctype="multipart/form-data" class="d-grid gap-2">
                    <input type="file" name="file" class="form-control form-control-sm" accept=".docx,.doc,.pdf,.odt" required />
                    <div class="form-check small">
                        <input class="form-check-input" type="checkbox" name="importText" value="true" id="importText" checked />
                        <label class="form-check-label" for="importText">Αν είναι .docx, ενημέρωσε και το κείμενο της σελίδας</label>
                    </div>
                    <button type="submit" class="btn btn-outline-primary btn-sm">⬆ Ανέβασμα @(string.IsNullOrWhiteSpace(doc.FilePath) ? "" : "(αντικατάσταση)")</button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body small">
                <h2 class="h6">Πώς το αλλάζω</h2>
                <ol class="ps-3 mb-0">
                    <li><strong>Γρήγορα:</strong> ✏️ → διορθώνεις το κείμενο → Αποθήκευση.</li>
                    <li><strong>Με Word:</strong> 📝 κατεβάζεις το .docx → το διορθώνεις → το ανεβάζεις εδώ. Το κείμενο της σελίδας ενημερώνεται μόνο του.</li>
                    <li><strong>Επίσημο PDF</strong> (π.χ. υπογεγραμμένο από τον Σύλλογο): ανέβασέ το — οι μαθητές μπορούν να το κατεβάσουν.</li>
                </ol>
            </div>
        </div>
    </div>
</div>
