@page
@model SchoolNetworkManager.Pages.Faults.IndexModel

@{
    ViewData["Title"] = "Βιβλίο βλαβών";
    var greek = new System.Globalization.CultureInfo("el-GR");
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">🔧 Βιβλίο βλαβών</h1>
        <p class="text-muted mb-0">
            @Model.Open.Count ανοιχτές
            · @Model.Open.Count(r => r.Fault.IsDown) εκτός λειτουργίας
            · @Model.RecentlyClosed.Count έκλεισαν τις τελευταίες 30 ημέρες
        </p>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        @if (Model.PublicEnabled)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-page="/Faults/Public" target="_blank" title="Χωρίς κωδικό — για τους συναδέλφους">🌐 Δημόσια σελίδα</a>
        }
        <a class="btn btn-sm btn-outline-primary" asp-page="/Faults/Public" asp-route-print="true" target="_blank">🖨 Εκτύπωση για τον πίνακα ανακοινώσεων</a>
        @if (Model.PortalEnabled)
        {
            <a class="btn btn-sm btn-outline-success" asp-page="/Public/Index" target="_blank" title="Η φόρμα για μαθητές και εκπαιδευτικούς">📨 Φόρμα δήλωσης βλάβης</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success shadow-sm">@Model.StatusMessage</div>
}

@if (Model.Pending.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>📥 Νέες δηλώσεις από τη δημόσια φόρμα <span class="badge text-bg-warning">@Model.Pending.Count</span></span>
            <span class="small text-muted fw-normal">Αποδοχή = μπαίνει στο βιβλίο βλαβών · 🗑️ = απόρριψη (π.χ. πλάκα ή διπλή)</span>
        </div>
        <div class="card-body d-grid gap-3">
            @foreach (var r in Model.Pending)
            {
                var device = r.ComputerId.HasValue ? Model.DevicesById.GetValueOrDefault(r.ComputerId.Value) : null;
                var duplicate = r.ComputerId.HasValue && Model.HasOpenFault.Contains(r.ComputerId.Value);
                <div class="card report-card @(r.Severity == SchoolNetworkManager.Models.Fault.SeverityDown ? "is-down" : "")">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
                            <div class="fw-semibold">
                                @(r.Severity == SchoolNetworkManager.Models.Fault.SeverityDown ? "⛔" : "🔧")
                                @r.Location ·
                                @(device != null ? (string.IsNullOrWhiteSpace(device.Name) ? device.IpAddress : device.Name) : (r.DeviceText ?? "—"))
                                @if (duplicate)
                                {
                                    <span class="badge text-bg-secondary ms-1" title="Η συσκευή έχει ήδη ανοιχτή βλάβη">έχει ήδη βλάβη</span>
                                }
                            </div>
                            <div class="report-meta">@r.CreatedAt.ToString("dd/MM HH:mm")@(string.IsNullOrWhiteSpace(r.ReporterLabel) ? "" : " · " + r.ReporterLabel)</div>
                        </div>
                        <div class="mb-2">@r.Description</div>
                        @if (device == null && !string.IsNullOrWhiteSpace(r.DeviceText))
                        {
                            <div class="report-meta mb-2">Έγραψε για τη συσκευή: «@r.DeviceText»</div>
                        }
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <form method="post" asp-page-handler="AcceptReport" asp-route-reportId="@r.Id" class="d-flex flex-wrap gap-2 align-items-center flex-grow-1">
                                <select name="computerId" class="form-select form-select-sm w-auto" required="@(device == null)">
                                    <option value="">@(device == null ? "— σε ποια συσκευή; —" : "✓ " + (string.IsNullOrWhiteSpace(device.Name) ? device.IpAddress : device.Name))</option>
                                    @foreach (var g in Model.DeviceGroups)
                                    {
                                        <optgroup label="@g.Key">
                                            @foreach (var c in g)
                                            {
                                                <option value="@c.Id">@(string.IsNullOrWhiteSpace(c.Name) ? c.IpAddress : c.Name + " · " + c.IpAddress)</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <select name="severity" class="form-select form-select-sm w-auto">
                                    @foreach (var sev in SchoolNetworkManager.Models.Fault.Severities)
                                    {
                                        <option value="@sev" selected="@(sev == r.Severity)">@sev</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-success">✓ Αποδοχή</button>
                            </form>
                            <form method="post" asp-page-handler="RejectReport" asp-route-reportId="@r.Id"
                                  onsubmit="return confirm('Απόρριψη της δήλωσης;');">
                                <button type="submit" class="row-action is-danger" data-hint="Απόρριψη" aria-label="Απόρριψη">🗑️</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="alert alert-light border small">
    💡 Νέα βλάβη καταχωρείς από την καρτέλα της συσκευής → «+ Αναφορά βλάβης».
    @if (!Model.PublicEnabled)
    {
        <span>Μπορείς να ενεργοποιήσεις <a asp-page="/Settings/Index" asp-route-tab="general">δημόσια σελίδα</a> ώστε οι συνάδελφοι να βλέπουν ποια μηχανήματα δεν λειτουργούν χωρίς κωδικό.</span>
    }
</div>

@if (!Model.Open.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-body text-center py-5">
            <div class="display-6 mb-2">👍</div>
            <div class="fw-semibold">Καμία ανοιχτή βλάβη</div>
        </div>
    </div>
}
else
{
    @foreach (var loc in Model.Open.GroupBy(r => r.LocationLabel))
    {
        <h2 class="h6 text-muted text-uppercase mt-4 mb-2">@loc.Key · @loc.Count()</h2>
        <div class="fault-grid mb-2">
            @foreach (var row in loc)
            {
                var f = row.Fault;
                <div class="card shadow-sm fault-card @(f.IsDown ? "is-down" : "is-open")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-2 mb-1">
                            @if (row.Computer != null)
                            {
                                <a class="fw-semibold text-decoration-none" asp-page="/Computers/Details" asp-route-id="@row.Computer.Id" asp-fragment="faults">
                                    @SchoolNetworkManager.Models.DeviceSpecs.TypeIcon(row.Computer.MachineType) @row.DeviceLabel
                                </a>
                            }
                            else
                            {
                                <span class="fw-semibold">@row.DeviceLabel</span>
                            }
                            <span class="fault-pill @(f.IsDown ? "is-down" : "")">@(f.IsDown ? "⛔" : "🔧") @f.Severity</span>
                        </div>
                        <div class="prewrap mb-2">@f.Description</div>
                        <div class="text-muted small mb-2">
                            @f.CreatedAt.ToString("ddd d/M · HH:mm", greek)
                            @if (!string.IsNullOrWhiteSpace(f.ReportedBy))
                            {
                                <span>· από @f.ReportedBy</span>
                            }
                            · πριν από @((int)(DateTime.Now - f.CreatedAt).TotalDays) ημέρες
                        </div>
                        <form method="post" asp-page-handler="Resolve" asp-route-faultId="@f.Id">
                            <div class="input-group input-group-sm">
                                <input name="resolution" class="form-control" placeholder="Τι έγινε; (προαιρετικά)" />
                                <button type="submit" class="btn btn-success">✓ Κλείσιμο</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
}

@if (Model.RecentlyClosed.Any())
{
    <details class="mt-4">
        <summary class="fw-semibold mb-2">✅ Έκλεισαν πρόσφατα (@Model.RecentlyClosed.Count)</summary>
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th>Συσκευή</th><th>Χώρος</th><th>Πρόβλημα</th><th>Τι έγινε</th><th>Έκλεισε</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.RecentlyClosed)
                            {
                                <tr>
                                    <td>@row.DeviceLabel</td>
                                    <td>@row.LocationLabel</td>
                                    <td>@row.Fault.Description</td>
                                    <td>@(row.Fault.Resolution ?? "—")</td>
                                    <td class="text-nowrap">
                                        @row.Fault.ResolvedAt?.ToString("dd/MM/yy")
                                        @if (!string.IsNullOrWhiteSpace(row.Fault.ResolvedBy))
                                        {
                                            <div class="small text-muted">@row.Fault.ResolvedBy</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </details>
}
