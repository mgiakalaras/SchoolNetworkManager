@using SchoolNetworkManager.Services
@model (List<RoomOption> Options, int? Selected, string FieldName, string? LegacyName)

<select class="form-select" name="@Model.FieldName">
    <option value="">— χωρίς χώρο —</option>
    @if (!string.IsNullOrEmpty(Model.LegacyName))
    {
        @* Συσκευή με παλιό κείμενο χώρου χωρίς εγγραφή χώρου: να μη σβηστεί στην αποθήκευση *@
        <option value="@RoomService.LegacyRoomId" selected="@(Model.Selected == RoomService.LegacyRoomId)">«@Model.LegacyName» (παλιός χώρος)</option>
    }
    @foreach (var group in Model.Options.GroupBy(o => o.Group))
    {
        <optgroup label="@group.Key">
            @foreach (var option in group)
            {
                <option value="@option.Id" selected="@(Model.Selected == option.Id)">@option.Name</option>
            }
        </optgroup>
    }
</select>
@if (!string.IsNullOrEmpty(Model.LegacyName))
{
    @* «Computer.RoomId» → «Computer.Location»: το παλιό κείμενο ξαναστέλνεται για τη νέα καταχώρηση / την επανεμφάνιση της φόρμας *@
    <input type="hidden" name="@(Model.FieldName[..^"RoomId".Length])Location" value="@Model.LegacyName" />
}
@{
    var roomError = ViewContext.ViewData.ModelState.TryGetValue(Model.FieldName, out var entry)
        ? entry.Errors.FirstOrDefault()?.ErrorMessage
        : null;
}
@if (!string.IsNullOrEmpty(roomError))
{
    <span class="text-danger small d-block" data-valmsg-for="@Model.FieldName">@roomError</span>
}
